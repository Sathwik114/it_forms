<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <rule name="ProxyToNextOn7003" stopProcessing="true">
          <match url="(.*)" />
          <action
            type="Rewrite"
            url="http://127.0.0.1:7003/{R:1}"
            appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>